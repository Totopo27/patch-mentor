  "cards": [
    {
      "dot": "cyan",
      "title": "Protocolo Digital y Pitch",
      "items": [
        "El DAW envia MIDI Notes hacia el convertidor DAC calibrado (uTune) y SysEx MTS hacia el Reface DX.",
        "Los voltajes de afinacion (1V/Oct) solo deben sumarse con adders de precision como el Doepfer A-185-2."
      ]
    },
    {
      "dot": "emerald",
      "title": "Nucleo de Sintesis Modular",
      "items": [
        "El VCO genera formas de onda bipolares de ~10 Vpp (+/- 5V).",
        "El audio viaja por filtros y amplificadores gobernados por envolventes generadas por Maths."
      ]
    },
    {
      "dot": "rose",
      "title": "Aislamiento y Proteccion",
      "items": [
        "El modulo de salida (Make Noise XOH) atenua la senal modular de 10 Vpp a nivel de linea estandar (+4 dBu).",
        "Nunca conectar salidas de oscilador directamente a entradas de linea de interfaces sin atenuador activo."
